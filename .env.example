# サイトの本番 URL（canonical / OGP / sitemap の基準。ビルド時に評価される）。
# 未設定なら Vercel の VERCEL_PROJECT_PRODUCTION_URL → http://localhost:3000 の順にフォールバックする。
SITE_URL=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# 下記はローカル確認用の公式テストキー（常に成功する）。本番では実キーに差し替える。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA